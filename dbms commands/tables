1. student
  create table student(stud_id int primary key, stud_name varchar(100) NOT NULL, Email varchar(200) UNIQUE NOT NULL, pwd_hash varchar(255) NOT NULL, Branch varchar(80), section varchar(10));
2. studies(intermediate entity)
create table studies(stud_id int, sub_id int, primary key(stud_id, sub_id), foreign key(stud_id) references student(stud_id), foreign key(sub_id) references subject(sub_id));
3. subject
create table subject(sub_id int primary key, sub_name varchar(100) NOT NULL);

4. timetable
create table timetable(stud_id int, sub_id int, day varchar(10) check(day in('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday')) NOT NULL, period_no int NOT NULL, primary key(stud_id, day, period_no), foreign key(stud_id) references student(stud_id), foreign key(sub_id) references subject(sub_id));

changing sub_id constraint to not null using postgres
alter table timetable alter column sub_id set NOT NULL;

5. attendance
create table attendance(att_id int primary key NOT NULL, stud_id int NOT NULL, sub_id int NOT NULL, date DATE NOT NULL, status varchar(8) check(status in('present', 'absent')) NOT NULL, foreign key(stud_id) references student(stud_id), foreign key(sub_id) references subject(sub_id));
