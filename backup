@app.route('/login', methods = ["POST"])
def login():
  data = request.get_json()
  email = data.get("email")
  pwd = data.get("password")
  if not email or not pwd:
        return jsonify({"error": "Invalid email or password"}), 401
  con = psycopg.connect(
          dbname = "att",
          user = "postgres",
          password = "avi",
          host = "localhost",
          port = "5432"
        )
  cur = con.cursor()
  cur.execute("select stud_id, pwd_hash from student where email = %s", (email,))
  stud = cur.fetchone()
  if stud is None:
        cur.close()
        con.close()
        return jsonify({"error": "Invalid email or password"}), 401
  id, pwd_hash = stud
  try:
    ph.verify(pwd_hash, pwd)
  except Exception:
        cur.close()
        con.close()
        return jsonify({"error": "Invalid email or password"}), 401

  cur.close()
  con.close()
  now = datetime.now(timezone.utc)
  print("SECRET:", secret)
  print("SECRET TYPE:", type(secret))
  access_token = jwt.encode(
    {
      "stud_id" : id,
      "type" : "access",
      "exp" : now + timedelta(hours = 3)
    },
    secret,
    algorithm = 'HS256'

  )

  refresh_jti = str(uuid.uuid4())
  refresh_exp = now + timedelta(days=7)
  refresh_token = jwt.encode(
        {
            "stud_id": id,
            "type": "refresh",
            "jti": refresh_jti,
            "exp": refresh_exp
        },
        secret,
        algorithm="HS256"
    )
  con = psycopg.connect(
            dbname = "att",
            user = "postgres",
            password = "avi",
            host = "localhost",
            port = "5432"
          )
  cur = con.cursor()
  cur.execute("""
    INSERT INTO refresh(jti, stud_id, expires_at)
    VALUES (%s, %s, %s)""",
    (refresh_jti, id, refresh_exp)
    )
  con.commit()
  cur.close()
  con.close()
  
  return jsonify({
        "access_token": access_token,
        "refresh_token": refresh_token
    }), 200

def token_req(function):
  @wraps(function)
  def func_wrapper(*args, **kwargs):
        auth_header = request.headers.get("Authorization")
        if not auth_header:
            return jsonify({"error" : "unauthorized user"}), 401

        if not auth_header.startswith("Bearer "):
            return jsonify({"error" : "invalid authorization header"}), 401

        b_token = auth_header.split(" ", 1)[1]
        try:
            payload = jwt.decode(b_token, secret, algorithms = ["HS256"])

        except InvalidTokenError:
            return jsonify({"error" : "invalid or expired token"}), 401
        p_type = payload.get("type")
        if not p_type == "access":
            return jsonify({"error" : "invalid token"}), 401
        id = payload["stud_id"]
        return function(id, *args, **kwargs)
  return func_wrapper
  
  
