<script>
/* ---------- config ---------- */
const API='http://localhost:5000';                 // Flask base URL
const DAYS=['Monday','Tuesday','Wednesday','Thursday','Friday'], PERIODS=8; // timetable grid size
const PREVIEW=location.search.includes('preview')||localStorage.preview==='1'; // ?preview shows the UI with fake data, no backend
const EGG={title:'Easter egg',text:'Put your favourite group here. Click the "Roll Call" logo five times to find me.'};

/* ---------- API layer: the only place that talks to the backend ---------- */
async function api(path,{method='GET',body,query,auth=true}={}){
  if(PREVIEW)return mock(path,method,query,body);
  const url=API+path+(query?'?'+new URLSearchParams(query):'');
  const headers={'Content-Type':'application/json'};
  if(auth)headers.Authorization='Bearer '+localStorage.token;
  const r=await fetch(url,{method,headers,body:body?JSON.stringify(body):undefined});
  const t=await r.text();let d;try{d=JSON.parse(t)}catch{d=t}   // some routes return plain text
  if(r.status===401&&auth){logout();throw new Error('Session ended. Please log in again.')}
  if(!r.ok)throw Object.assign(new Error((d&&d.error)||d||'Request failed'),{status:r.status});
  return d;
}
const getNote=async date=>{try{return(await api('/notes',{query:{date}})).text}catch(e){if(e.status===404)return null;throw e}};
const pk=(d,k)=>Object.entries(d).find(([a])=>a.startsWith(k))?.[1];   // predict keys end with " : "
async function predict(id){const d=await api('/predict',{query:{sub_id:id}});return d.error?null:{p:+pk(d,'attendance'),s:+pk(d,'safe'),r:+pk(d,'recovery')}}

/* ---------- preview-only fake backend (delete if you like) ---------- */
const MOCK={subjects:[{sub_id:1,sub_name:'Database Management Systems'},{sub_id:2,sub_name:'Data Structures'},{sub_id:3,sub_name:'Operating Systems'}],pred:{1:[82.4,2,0],2:[71.2,0,3],3:[90,5,0]},notes:{}};
MOCK.tt=DAYS.flatMap((d,i)=>[1,2,3,4].map(p=>{const s=MOCK.subjects[(i+p)%3];return{sub_id:s.sub_id,sub_name:s.sub_name,day:d,period_no:p}}));
async function mock(path,method,query,body){
  const nf=()=>{throw Object.assign(new Error('note not found'),{status:404})};
  if(path==='/login')return{access_token:'x',refresh_token:'y'};
  if(path==='/subjects'){if(method==='GET')return{subjects:MOCK.subjects};
    if(method==='POST')MOCK.subjects.push({sub_id:Date.now(),sub_name:body.subject[0]});
    if(method==='PATCH')MOCK.subjects.find(s=>s.sub_id==body.sub_id).sub_name=body.new_sub_name;
    if(method==='DELETE')MOCK.subjects=MOCK.subjects.filter(s=>s.sub_id!=body.sub_id);return'ok'}
  if(path==='/timetable'){if(method==='GET')return{subjects:MOCK.tt};MOCK.tt.push({...body,sub_name:MOCK.subjects.find(x=>x.sub_id==body.sub_id).sub_name});return'ok'}
  if(path==='/attendance')return method==='GET'?{attendance:[]}:'ok';
  if(path==='/predict'){const p=MOCK.pred[query.sub_id];return p?{'attendance percentage : ':p[0],'safe leaves : ':p[1],'recovery classes : ':p[2]}:{error:'no classes occurred yet'}}
  if(path==='/notes'){const d=(query||body).date;
    if(method==='GET')return MOCK.notes[d]==null?nf():{text:MOCK.notes[d]};
    if(MOCK.notes[d]==null&&method!=='POST')nf();
    if(method==='DELETE')delete MOCK.notes[d];else MOCK.notes[d]=body.text??body.new_note;return'ok'}
}
/* ---------- helpers ---------- */
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const iso=d=>{const x=new Date(d);return new Date(x-x.getTimezoneOffset()*6e4).toISOString().slice(0,10)};
const dayName=i=>new Date(i+'T00:00').toLocaleDateString('en-US',{weekday:'long'});
const S={subjects:[],tt:[]};
let tt_;function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(tt_);tt_=setTimeout(()=>t.classList.remove('on'),2800)}
function countUp(el,to){const t0=performance.now();(function f(t){const k=Math.min((t-t0)/900,1);el.textContent=(to*k).toFixed(1)+'%';if(k<1)requestAnimationFrame(f)})(t0)}
const mood=p=>p>=85?'Comfortably ahead.':p>=75?'Safe, but no heroics.':'Under the line. Time to show up.';
const plural=(n,w)=>n+' '+w+(n==1?'':'es');
const opts=(sel)=>'<option value="">Select subject</option>'+S.subjects.map(s=>`<option value="${s.sub_id}" ${s.sub_id==sel?'selected':''}>${esc(s.sub_name)}</option>`).join('');
function animate(root){root.querySelectorAll('.num').forEach(n=>countUp(n,+n.dataset.to));setTimeout(()=>root.querySelectorAll('.bar i').forEach(b=>b.style.width=b.dataset.w+'%'),60)}

/* ---------- data loaders ---------- */
const loadSubj=async()=>{S.subjects=(await api('/subjects')).subjects||[]};
const loadTT=async()=>{try{S.tt=(await api('/timetable')).subjects||[]}catch(e){if(e.status!==404)throw e;S.tt=[]}};

/* ---------- views ---------- */
async function dash(){
  const today=iso(new Date()),h=new Date().getHours(),day=dayName(today),n=S.tt.filter(e=>e.day===day).length;
  $('#view').innerHTML=`<div class="hero"><div class="glass"><h1>${h<12?'Morning':h<18?'Afternoon':'Evening'}, you.</h1><p id="rem">Checking today...</p><div id="cta"></div></div></div><h2>Your subjects</h2><div class="grid" id="stats"></div>`;
  let done=0;try{done=((await api('/attendance',{query:{date:today}})).attendance||[]).length}catch{}
  $('#rem').textContent=!n?'Nothing on the timetable today. How is it going otherwise?':done>=n?'All good! Today is marked. Go be a person.':`${n-done} of ${n} classes still unmarked today. It takes a minute.`;
  if(n&&done<n)$('#cta').innerHTML='<a href="#att" class="btn" style="text-decoration:none;display:inline-block">Mark attendance</a>';
  if(!S.subjects.length){$('#stats').innerHTML='<p class="mut">No subjects yet. Add some under Subjects.</p>';return}
  const res=await Promise.all(S.subjects.map(s=>predict(s.sub_id).catch(()=>null)));
  $('#stats').innerHTML=S.subjects.map((s,i)=>{const r=res[i];return`<div class="flip" tabindex="0"><div class="fi"><div><span class="nm">${esc(s.sub_name)}</span>${r?`<span class="num" data-to="${r.p}">0%</span><div class="bar"><i class="${r.p<75?'lo':''}" data-w="${Math.min(r.p,100)}"></i><b></b></div><small>${mood(r.p)}</small>`:'<span class="mut">No classes held yet.</span>'}</div><div class="bk">${r?`<span class="nm">${esc(s.sub_name)}</span><span>Safe leaves: <b>${r.s}</b></span><span>Recovery classes: <b>${r.r}</b></span><small>tap to flip back</small>`:'<span>Nothing to predict yet.</span>'}</div></div></div>`}).join('');
  document.querySelectorAll('.flip').forEach(f=>{f.onclick=()=>f.classList.toggle('on');f.onkeydown=e=>e.key=='Enter'&&f.classList.toggle('on')});
  animate($('#stats'));
}

async function att(){
  let date=iso(new Date()),orig={},note=null;
  $('#view').innerHTML=`<h1>Attendance</h1><div class="card"><label>Date <input type="date" id="d" value="${date}"></label></div><div class="card" id="rows"></div><div class="card"><h3>Note for the day</h3><textarea id="nt" placeholder="Anything worth remembering?"></textarea></div><button class="btn" id="sv">Save all</button>`;
  const rowsFor=()=>S.tt.filter(e=>e.day===dayName(date)).sort((a,b)=>a.period_no-b.period_no);
  async function load(){
    date=$('#d').value;orig={};
    try{((await api('/attendance',{query:{date}})).attendance||[]).forEach(a=>orig[a.period]=String(a.status).toLowerCase())}catch{}
    const rows=rowsFor();
    $('#rows').innerHTML=rows.length?rows.map(e=>`<div class="row"><span class="per">P${e.period_no}</span><span class="grow">${esc(e.sub_name)}</span><span class="seg">${['present','absent'].map(s=>`<label><input type="radio" name="p${e.period_no}" value="${s}" ${orig[e.period_no]===s?'checked':''}><span class="${s[0]}">${s}</span></label>`).join('')}</span></div>`).join(''):`<p class="mut">Nothing on the timetable for ${dayName(date)}. Fill it in under Timetable.</p>`;
    note=await getNote(date);$('#nt').value=note??'';
  }
  $('#d').onchange=()=>load().catch(e=>toast(e.message));
  $('#sv').onclick=async()=>{try{
    for(const e of rowsFor()){const c=document.querySelector(`input[name=p${e.period_no}]:checked`);
      if(c&&c.value!==orig[e.period_no])await api('/attendance',{method:'POST',body:{sub_id:e.sub_id,date,status:c.value,period_no:e.period_no}})}
    const t=$('#nt').value.trim();
    if(t&&t!==note)await api('/notes',note===null?{method:'POST',body:{text:t,date}}:{method:'PATCH',body:{date,new_note:t}});
    toast('Saved. Nice work.');await load();
  }catch(e){toast(e.message)}};
  await load();
}

async function pred(){
  $('#view').innerHTML=`<h1>Prediction</h1><div class="card"><label>Subject <select id="ps">${opts()}</select></label></div><div id="po"></div>`;
  $('#ps').onchange=async e=>{
    const o=$('#po');if(!e.target.value){o.innerHTML='';return}
    try{const r=await predict(e.target.value);
      if(!r){o.innerHTML='<div class="card"><p>No classes have been held for this subject yet, so there is nothing to predict.</p></div>';return}
      o.innerHTML=`<div class="card"><div class="big num" data-to="${r.p}">0%</div><div class="bar"><i class="${r.p<75?'lo':''}" data-w="${Math.min(r.p,100)}"></i><b></b></div><small>The line marks 75%.</small>
      <p>${r.p>=75?`You can skip ${plural(r.s,'class')} and still sit at 75%.`:`Attend ${plural(r.r,'class')} in a row to climb back to 75%.`} ${mood(r.p)}</p></div>
      <div class="card"><h3>What happens if I miss?</h3><label>Classes missed <input type="number" id="wi" min="0" value="1" style="width:5em"></label><p id="wo"></p></div>`;
      animate(o);
      const calc=()=>{const n=Math.max(0,+$('#wi').value||0);$('#wo').textContent=n===0?'Nothing changes.':n<=r.s?`Missing ${n}: still at or above 75%, with ${r.s-n} spare after that.`:`Missing ${n}: that is ${n-r.s} past your safe limit. You would drop under 75% and need to attend more to recover.`};
      $('#wi').oninput=calc;calc();
    }catch(x){toast(x.message)}};
}

async function notes(){
  let days=14;
  $('#view').innerHTML=`<h1>Notes</h1><div class="card"><input type="date" id="nd" value="${iso(new Date())}"><textarea id="nt2" placeholder="Write a note for this date"></textarea><button class="btn" id="ns">Save note</button></div><div class="grid" id="nb"></div><p><button class="btn ghost" id="more">Load earlier</button></p>`;
  let cur=null;
  const sync=async()=>{cur=await getNote($('#nd').value);$('#nt2').value=cur??''};
  async function list(){
    const ds=[...Array(days)].map((_,i)=>iso(Date.now()-i*864e5));
    const res=await Promise.all(ds.map(d=>getNote(d).catch(()=>null)));
    $('#nb').innerHTML=ds.map((d,i)=>res[i]==null?'':`<div class="card note"><small>${new Date(d+'T00:00').toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'})}</small><p>${esc(res[i])}</p><button class="lnk" data-e="${d}">Edit</button><button class="lnk" data-x="${d}">Delete</button></div>`).join('')||'<p class="mut">No notes in this stretch of days.</p>';
  }
  $('#nd').onchange=()=>sync().catch(e=>toast(e.message));
  $('#ns').onclick=async()=>{const t=$('#nt2').value.trim(),date=$('#nd').value;if(!t)return toast('Write something first.');
    try{await api('/notes',cur===null?{method:'POST',body:{text:t,date}}:{method:'PATCH',body:{date,new_note:t}});toast('Note saved.');await sync();await list()}catch(e){toast(e.message)}};
  $('#more').onclick=()=>{days+=14;list()};
  $('#nb').onclick=async e=>{const b=e.target;
    if(b.dataset.e){$('#nd').value=b.dataset.e;await sync();scrollTo({top:0,behavior:'smooth'})}
    if(b.dataset.x&&confirm('Delete this note?')){try{await api('/notes',{method:'DELETE',body:{date:b.dataset.x}});toast('Note deleted.');await sync();await list()}catch(x){toast(x.message)}}};
  await sync();await list();
}

async function tt(){
  const find=(d,p)=>S.tt.find(e=>e.day===d&&e.period_no===p);
  $('#view').innerHTML=`<h1>Timetable</h1><div class="card tw"><table><tr><th></th>${DAYS.map(d=>`<th>${d.slice(0,3)}</th>`).join('')}</tr>${[...Array(PERIODS)].map((_,i)=>`<tr><th>P${i+1}</th>${DAYS.map(d=>{const e=find(d,i+1);return`<td><select data-d="${d}" data-p="${i+1}" ${e?'disabled':''}>${opts(e?.sub_id)}</select></td>`}).join('')}</tr>`).join('')}</table></div><p class="mut">Pick a subject to place it. A saved period is locked because the backend has no edit or remove for the timetable yet.</p>`;
  $('#view table').onchange=async e=>{const s=e.target;if(!s.value)return;
    try{await api('/timetable',{method:'POST',body:{sub_id:+s.value,day:s.dataset.d,period_no:+s.dataset.p}});await loadTT();s.disabled=true;toast('Period saved.')}
    catch(x){toast(x.message);s.value=''}};
}

async function subs(){
  const draw=()=>{$('#sl').innerHTML=S.subjects.map(s=>`<div class="row"><input class="grow" value="${esc(s.sub_name)}" disabled data-id="${s.sub_id}"><button class="lnk" data-ed="${s.sub_id}">Edit</button><button class="lnk" data-del="${s.sub_id}">Delete</button></div>`).join('')||'<p class="mut">No subjects yet. Add your first one above.</p>'};
  $('#view').innerHTML=`<h1>Subjects</h1><div class="card"><div class="row" style="border:0"><input id="sn" class="grow" placeholder="Subject name"><button class="btn" id="sa">Add subject</button></div></div><div class="card" id="sl"></div>`;
  draw();
  $('#sa').onclick=async()=>{const n=$('#sn').value.trim();if(!n)return;
    try{await api('/subjects',{method:'POST',body:{subject:[n],sub_name:n}});$('#sn').value='';await loadSubj();draw();toast('Subject added.')}catch(e){toast(e.message)}};
  $('#sl').onclick=async e=>{const b=e.target,id=b.dataset.ed||b.dataset.del;if(!id)return;const inp=$(`input[data-id="${id}"]`);
    try{
      if(b.dataset.del){if(!confirm('Remove this subject?'))return;await api('/subjects',{method:'DELETE',body:{sub_id:+id}});await Promise.all([loadSubj(),loadTT()]);draw();toast('Subject removed.')}
      else if(inp.disabled){inp.disabled=false;inp.focus();b.textContent='Save'}
      else{await api('/subjects',{method:'PATCH',body:{sub_id:+id,new_sub_name:inp.value.trim()}});await Promise.all([loadSubj(),loadTT()]);draw();toast('Subject updated.')}
    }catch(x){toast(x.message)}};
}

/* ---------- router + session ---------- */
const R={dash:['Home',dash],att:['Attendance',att],pred:['Prediction',pred],notes:['Notes',notes],tt:['Timetable',tt],subs:['Subjects',subs]};
$('#nav').innerHTML=Object.entries(R).map(([k,v])=>`<a href="#${k}" data-k="${k}">${v[0]}</a>`).join('');
function route(){if(!localStorage.token)return;const k=R[location.hash.slice(1)]?location.hash.slice(1):'dash';
  document.querySelectorAll('#nav a').forEach(a=>a.classList.toggle('on',a.dataset.k===k));R[k][1]().catch(e=>toast(e.message))}
async function start(){$('#auth').hidden=true;$('#app').hidden=false;
  try{await Promise.all([loadSubj(),loadTT()])}catch(e){toast(e.message)}route()}
function logout(){localStorage.clear();$('#app').hidden=true;$('#auth').hidden=false;location.hash=''}
addEventListener('hashchange',route);$('#out').onclick=logout;
$('#lf').onsubmit=async e=>{e.preventDefault();$('#err').textContent='';
  try{const d=await api('/login',{method:'POST',auth:false,body:{email:$('#em').value,password:$('#pw').value}});
    localStorage.token=d.access_token;localStorage.refresh=d.refresh_token;start()}
  catch(x){$('#err').textContent=x.message==='Failed to fetch'?'Cannot reach the server. Is Flask running with CORS on?':x.message}};
let clicks=0;$('#brand').onclick=()=>{if(++clicks>=5){clicks=0;$('#eh').textContent=EGG.title;$('#et').textContent=EGG.text;$('#egg').hidden=false}};
$('#pv').onclick=()=>{localStorage.preview='1';localStorage.token='preview';location.hash='';location.reload()};
if(PREVIEW)localStorage.token='preview';
if(localStorage.token)start();
</script>
</body></html>
