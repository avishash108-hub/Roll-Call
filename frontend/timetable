<style>
:root{--bg:#DDE5E0;--ink:#2B3633;--mut:#586561;--card:#F8F6F2;--sky:#B3CBCD;--sage:#A9C7B2;--sage2:#5E8F72;--butter:#EBD58E;--blush:#E3A9B4;--rose:#C0617A;--line:#C3CFC8;--sh:0 6px 16px rgba(43,54,51,.2);--r:14px;--doodle:url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220' fill='none' stroke='%232B3633' stroke-opacity='.15' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path d='M30 18l4 10 11 1-8 7 3 11-10-6-10 6 3-11-8-7 11-1z'/><path d='M120 46c-14-9-18-16-12-22 5-5 11-2 12 3 1-5 7-8 12-3 6 6 2 13-12 22z'/><circle cx='176' cy='56' r='4'/><path d='M180 56V28l14-4v26'/><circle cx='190' cy='50' r='4'/><path d='M26 104q10-6 20 0 10-6 20 0v28q-10-6-20 0-10-6-20 0zM46 104v28'/><path d='M132 138l22-22 6 6-22 22-8 2zM154 116l4-4 6 6-4 4'/><circle cx='44' cy='190' r='13'/><path d='M44 190v-8M44 190l6 3'/><path d='M96 188q8-12 16 0t16 0 16 0'/><path d='M170 186q-8 0-6-8 3-7 10-4 4-8 12-3 5 4 3 9 6 1 4 6-2 4-7 4z'/><path d='M96 92l7 8 14-16'/><path d='M200 104v10M195 109h10'/><path d='M78 40q4-6 8 0t8 0'/></svg>")}
*{box-sizing:border-box}body{margin:0;background:var(--bg) var(--doodle);background-size:220px;color:var(--ink);font:16px/1.5 'DM Sans',system-ui,sans-serif}
h1,h2,h3{font-family:Fraunces,Georgia,serif;margin:.2em 0 .5em;line-height:1.15}h1{font-size:2rem}h2{font-size:1.4rem;margin-top:1.6em}h3{font-size:1.1rem}
.mut,small{color:var(--mut)}[hidden]{display:none!important}
input,select,textarea{font:inherit;color:inherit;background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:.55em .7em;max-width:100%}
input:focus,select:focus,textarea:focus,button:focus-visible,a:focus-visible{outline:2px solid var(--sage2);outline-offset:2px}
textarea{width:100%;min-height:90px;resize:vertical;display:block;margin:.6em 0}
.btn{background:var(--rose);color:#fff;border:0;border-radius:12px;padding:.65em 1.3em;font:700 .95rem 'DM Sans',sans-serif;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 4px 0 #9E4A61;transition:transform .15s}
.btn:hover{transform:translateY(-1px)}.btn:active{transform:translateY(3px);box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 1px 0 #9E4A61}
.btn.ghost{background:var(--sky);color:var(--ink);box-shadow:inset 0 1px 0 rgba(255,255,255,.5),0 4px 0 #8DA9AC}
.lnk{background:none;border:0;color:var(--mut);font:inherit;text-decoration:underline;cursor:pointer;padding:.2em .5em .2em 0}
.card{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:1.1em 1.3em;margin:0 0 1em}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1em}.grid .card{margin:0}
.row{display:flex;align-items:center;gap:.8em;padding:.6em 0;border-bottom:1px dashed var(--line)}.row:last-child{border:0}.grow{flex:1}.per{background:var(--butter);border-radius:8px;padding:.1em .6em;font-weight:700;font-size:.85rem}
/* auth */
.auth{min-height:100vh;display:grid;place-items:center;padding:1em}
.auth form{width:min(380px,100%);text-align:center;background:var(--card);border-radius:20px;box-shadow:var(--sh);padding:2em 1.8em}.auth label{display:block;text-align:left;font-weight:500;margin:.8em 0}.auth input{width:100%;margin-top:.25em}
.err{color:#8F2D42;min-height:1.4em;font-size:.9rem}
/* shell: sidebar acts like folder tabs */
#app{display:grid;grid-template-columns:230px 1fr;min-height:100vh}
aside{background:var(--sky);padding:26px 0 26px 16px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column}
#brand{font:700 1.5rem Fraunces,serif;padding:0 1em 1em;cursor:pointer;user-select:none}
nav{display:flex;flex-direction:column;gap:6px;flex:1}
nav a{color:var(--ink);text-decoration:none;padding:.75em 1em;border-radius:16px 0 0 16px;transition:transform .2s,background .2s}
nav a:hover{transform:translateX(-3px) rotate(-1deg);background:rgba(255,255,255,.5)}nav a.on{background:var(--bg);font-weight:700;box-shadow:-4px 4px 10px rgba(70,95,90,.1)}
aside .lnk{text-align:left;padding:.8em 1em}
main{padding:2em clamp(1em,4vw,3em) 4em;max-width:1000px;width:100%}
/* hero + glass */
.hero{border-radius:20px;padding:1.4em;background:var(--blush);margin-bottom:1em;box-shadow:var(--sh)}
.glass{background:rgba(255,255,255,.4);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.6);border-radius:var(--r);padding:1.2em 1.4em;box-shadow:var(--sh)}.glass h1{margin:0}
/* flip cards */
.flip{perspective:900px;height:150px;cursor:pointer}.fi{position:relative;height:100%;transition:transform .6s;transform-style:preserve-3d}.flip.on .fi{transform:rotateY(180deg)}
.fi>div{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:var(--r);box-shadow:var(--sh);padding:1em 1.2em;background:var(--card);display:flex;flex-direction:column;justify-content:space-between}
.fi .bk{transform:rotateY(180deg);background:var(--butter)}.num{font:700 2rem Fraunces,serif}.nm{font-weight:700}
.bar{height:10px;background:var(--line);border-radius:9px;overflow:hidden;position:relative}.bar i{display:block;height:100%;width:0;border-radius:9px;background:var(--sage2);transition:width 1s ease}.bar i.lo{background:var(--rose)}
.bar b{position:absolute;left:75%;top:-2px;bottom:-2px;width:2px;background:var(--ink);opacity:.4}
.big{font:700 3.4rem Fraunces,serif}
/* segmented present/absent */
.seg{display:flex;gap:6px}.seg input{display:none}.seg span{display:block;padding:.35em .9em;border-radius:10px;background:var(--bg);border:1.5px solid var(--line);cursor:pointer;font-size:.9rem;transition:.15s}
.seg input:checked+span.p{background:var(--sage);border-color:var(--sage2);font-weight:700}.seg input:checked+span.a{background:var(--blush);border-color:var(--rose);font-weight:700}
.note p{margin:.4em 0 .6em;white-space:pre-wrap}
table{border-collapse:separate;border-spacing:6px;width:100%}th{font-family:Fraunces,serif;font-weight:500;text-align:left;padding:.3em}td select{width:100%;min-width:120px;background:var(--bg)}td select:disabled{opacity:1;color:var(--ink);font-weight:500;background:var(--sage)}
.tw{overflow-x:auto}
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,80px);background:var(--ink);color:#fff;padding:.7em 1.2em;border-radius:12px;transition:transform .3s;z-index:20;max-width:90%}.toast.on{transform:translate(-50%,0)}
#egg{position:fixed;inset:0;background:rgba(53,64,61,.45);display:grid;place-items:center;z-index:30}#egg .card{max-width:380px;text-align:center}
@media(max-width:760px){#app{grid-template-columns:1fr}aside{position:fixed;bottom:0;left:0;right:0;top:auto;height:auto;flex-direction:row;padding:6px 6px 0;z-index:10;box-shadow:0 -4px 14px rgba(70,95,90,.15)}
#brand,aside .lnk{display:none}nav{flex-direction:row;gap:2px;justify-content:space-around}nav a{font-size:.7rem;padding:.6em .4em;border-radius:12px 12px 0 0;text-align:center;flex:1}nav a:hover{transform:none}main{padding-bottom:6em}h1{font-size:1.6rem}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
