i) post

@app.route("/subjects", methods = ["POST"])
#stud_id = from jwt
def add_sub():
 data = request.get_json()
 subjects = data.get("subject", "")
 #sql query
 con = name.connect(...)
 cur = con.cursor()
 #data gives a full list so
 for sub in subjects:
 cur.execute("insert into subject(sub_name) values(%s)", (sub, )) #one element tuple, we use tuples to pass values here
 con.commit()
 cur.close()
 con.close()
 return "subjects added successfully", 200
 
 
