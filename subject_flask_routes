 #data gives a full list so
 cur.execute("select sub_name from subject join studies on subject.sub_id = studies.sub_id where studies.stud_id = %s", (stud_id,)))
 rec = cur.fetchall()
 cur.close()
 con.close()
subnames = [row[0] for row in rec] #removes tuple wrapper arounde each sub_name as postgres returns in form of 1 tuple as 1 row all tuples inside a list
