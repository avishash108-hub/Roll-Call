i) post
@app.route("/notes", methods = ["POST"])
FRONTEND SENDS : {"note" : ...}
#stud_id = from jwt
def add_notes():
 data = request.get_json()
 note = data.get("note", "")
 #sql query
 con = name.connect(...)
 cur = con.cursor()
 cur.execute("insert into notes(stud_id, date, note) values(%s, %s, %s)", (stud_id, date, note)) #one element tuple, we use tuples to pass values here
 con.commit()
 cur.close()
 con.close()
 return "note added successfully", 200


ii) get
@app.route("/notes", methods = ["GET"])
#stud_id = from jwt
def fetch_sub():
 
 #sql query
 con = name.connect(...)
 cur = con.cursor()
 #data gives a full list so
 cur.execute("select note from notes where stud_id = %s and date = %s", (stud_id, date))
 rec = cur.fetchone()
 note = rec[0]
 cur.close()
 con.close()
 return jsonify({"note" : note}), 200

